# 仅供后续配置参考；复制为 .env 并填入真实值，.env 不提交。
DATABASE_URL=sqlite:///./pet_agent.db
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 高德 Web 服务 Key（P1-9）：配置后 /api/v1/nearby 查询真实 POI；
# 未配置或高德失败时按契约回落演示数据并标注来源。留空表示未接入。
AMAP_WEB_SERVICE_KEY=

# 演示区域中心（WGS84 十进制度数），用于 /api/v1/nearby/demo 及演示种子地点；
# 未配置时使用内置默认演示中心。
PET_AGENT_DEMO_CENTER_LAT=39.9001
PET_AGENT_DEMO_CENTER_LNG=116.4001
